{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "node"
    ],
    "paths": {
      "@linkrunway/sdk": [
        "./sdk/src/index.ts"
      ],
      "@linkrunway/sdk-react-native": [
        "./react-native/src/index.ts"
      ]
    }
  },
  "include": [
    "sdk/src",
    "react-native/src",
    "expo/src",
    "test"
  ]
}
