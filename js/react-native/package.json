{
  "name": "@linkrunway/sdk-react-native",
  "version": "0.1.0",
  "description": "LinkRunway for React Native: storage, incoming links, the offline queue and first-launch matching on top of @linkrunway/sdk.",
  "license": "MIT",
  "author": "Kimeur Labs, LLC <support@linkrunway.com>",
  "homepage": "https://github.com/LinkRunway/linkrunway-sdks/tree/main/js/react-native#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LinkRunway/linkrunway-sdks.git",
    "directory": "js/react-native"
  },
  "bugs": {
    "url": "https://github.com/LinkRunway/linkrunway-sdks/issues",
    "email": "support@linkrunway.com"
  },
  "keywords": [
    "linkrunway",
    "attribution",
    "deep-links",
    "react-native"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --target es2020",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@linkrunway/sdk": "^0.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
