{
  "name": "@linkrunway/sdk-expo",
  "version": "0.1.0",
  "description": "LinkRunway for Expo: the React Native SDK plus a config plugin that declares your link domains.",
  "license": "MIT",
  "author": "Kimeur Labs, LLC <support@linkrunway.com>",
  "homepage": "https://github.com/LinkRunway/linkrunway-sdks/tree/main/js/expo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LinkRunway/linkrunway-sdks.git",
    "directory": "js/expo"
  },
  "bugs": {
    "url": "https://github.com/LinkRunway/linkrunway-sdks/issues",
    "email": "support@linkrunway.com"
  },
  "keywords": [
    "linkrunway",
    "attribution",
    "deep-links",
    "expo",
    "react-native",
    "config-plugin"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./app.plugin.js": "./app.plugin.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "app.plugin.js",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup --entry.index src/index.ts --entry.plugin src/plugin/index.ts --format esm,cjs --dts --clean --target es2020",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@linkrunway/sdk-react-native": "^0.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@expo/config-plugins": "*"
  }
}
